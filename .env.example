# Copy this file to `.env` for local development. It is loaded by app/__init__.py
# via python-dotenv, so `python -m app.main`, pytest and the seed scripts all see it.
# In production nothing reads a file: `docker run --env-file` injects these as real
# environment variables, and real variables always win over .env.
# .env is gitignored; this template is not.

# Local dev with docker-compose Postgres:
DATABASE_URL=postgresql://venturekeep:venturekeep@localhost:5432/venturekeep

# Production (Neon serverless Postgres):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/venturekeep?sslmode=require

# Auth — REQUIRED in production (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
# VENTUREKEEP_SECRET_KEY=your-secret-key-here

# CORS — comma-separated origins (defaults to "*" for local dev)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Environment name reported to Sentry. Set to production on the server.
# APP_ENV=production

# Sentry — exception monitoring (omit to disable)
# SENTRY_DSN=https://your-dsn@o00000.ingest.us.sentry.io/00000

# Frontend error tracking. Separate Sentry project from SENTRY_DSN above, and it
# must carry the VITE_ prefix or Vite will not expose it to client code. Vite
# inlines this at BUILD time, so it has to be set wherever the frontend is built,
# not just where it runs. Put the real value in frontend/.env.local (gitignored).
# VITE_SENTRY_DSN=https://your-public-key@o00000.ingest.us.sentry.io/00000
